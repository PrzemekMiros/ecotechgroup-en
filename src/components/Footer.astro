---
import NavigationLink from "./NavigationLink.astro";
const quickLinks = [
  { href: "/rury-stalowe/", label: "Steel pipes" },
  { href: "/uslugi/", label: "Services" },
  { href: "/produkcja/", label: "Manufacturing" },
  { href: "/dostawa-rur-stalowych/", label: "Pipe delivery" },
  { href: "/kontakt/", label: "Contact" },
];
const companyLinks = [
  { href: "/o-nas/", label: "About us" },
  { href: "/aktualnosci/", label: "News" },
  { href: "/do-pobrania/", label: "Downloads" },
  { href: "/praca/", label: "Careers" },
  { href: "/kalkulator-wagi-rur-stalowych/", label: "Pipe weight calculator" },
];
---

<footer class="border-t border-white/10 bg-[#07111e] text-white">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid border-x border-white/10 md:grid-cols-2 lg:grid-cols-4">
      <section
        class="border-b border-white/10 px-6 py-10 md:border-r lg:border-b-0 lg:px-8 lg:py-16"
        aria-labelledby="footer-links"
      >
        <p
          id="footer-links"
          class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55"
        >
          Quick links
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-5 text-white/75">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-sun">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section
        class="border-b border-white/10 px-6 py-10 md:px-8 lg:border-b-0 lg:border-r lg:py-16"
        aria-labelledby="footer-company"
      >
        <p
          id="footer-company"
          class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55"
        >
          Eco Tech Group
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-5 text-white/75">
          {companyLinks.map((link) => (
            <li>
              <NavigationLink
                href={link.href}
                class="transition-colors hover:text-sun"
              >
                {link.label}
              </NavigationLink>
            </li>
          ))}
        </ul>
      </section>
      <section
        class="border-b border-white/10 px-6 py-10 md:border-r md:px-8 lg:border-b-0 lg:py-16"
        aria-labelledby="footer-contact"
      >
        <p
          id="footer-contact"
          class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55"
        >
          Contact
        </p>
        <div class="mt-6 space-y-3 text-sm leading-6 text-white/75">
          <a
            href="tel:+48508299077"
            class="block transition-colors hover:text-sun"
          >
            +48 508 299 077
          </a>
          <a
            href="mailto:sprzedaz@ecotechgroup.pl"
            class="block break-words transition-colors hover:text-sun"
          >
            sales@ecotechgroup.pl
          </a>
          <p class="pt-2 text-white/50">
            Monday–Friday
            <br />
            8:00–16:00
          </p>
        </div>
      </section>
      <section
        class="px-6 py-10 md:px-8 lg:py-16"
        aria-labelledby="footer-address"
      >
        <p
          id="footer-address"
          class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55"
        >
          Registered office
        </p>
        <address class="mt-6 text-sm leading-6 not-italic text-white/75">
          Eco Tech Group Sp. z o.o.
          <br />
          ul. Mieczysława Pożaryskiego 32
          <br />
          04-703 Warsaw, Poland
        </address>
        <dl class="mt-4 text-sm leading-6 text-white/75">
          <div>
            <dt class="inline">VAT ID:</dt>
            <dd class="inline whitespace-nowrap">PL6751452852</dd>
          </div>
          <div>
            <dt class="inline">REGON:</dt>
            <dd class="inline whitespace-nowrap">121 524 962</dd>
          </div>
          <div>
            <dt class="inline">KRS:</dt>
            <dd class="inline whitespace-nowrap">000 038 60 48</dd>
          </div>
        </dl>
        <a
          href="/kontakt/"
          class="mt-4 inline-flex text-sm font-semibold text-sun transition-colors hover:text-white"
        >
          View map →
        </a>
      </section>
    </div>
    <div class="grid border-x border-white/10 border-t border-white/10 md:grid-cols-[1fr_auto]">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4 px-6 py-5 md:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">
          Follow us
        </p>
        <a
          href="https://www.facebook.com/RurystaloweHurtownia"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-white/70 hover:text-sun"
        >
          Facebook
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 px-6 py-5 text-sm text-white/50 md:border-l md:border-t-0 md:px-8">
        <NavigationLink href="/polityka-prywatnosci/" class="hover:text-white">
          Privacy policy
        </NavigationLink>
        <NavigationLink href="/kontakt/" masked class="hover:text-white">
          Cookies
        </NavigationLink>
      </div>
    </div>
    <div class="grid gap-7 border-x border-white/10 border-t border-white/10 px-6 py-9 md:grid-cols-[minmax(14rem,0.8fr)_minmax(0,1.2fr)] md:items-center md:px-8 md:py-10">
      <a href="/" class="w-fit" aria-label="Eco Tech Group home page">
        <img
          src="/img/logo/EcoTech_Logo_white.png"
          width="350"
          height="53"
          alt="Eco Tech Group"
          class="h-9 w-auto"
          loading="lazy"
        />
      </a>
      <p class="max-w-2xl text-sm leading-6 text-white/45 md:justify-self-end">
        Eco Tech Group supplies steel pipes, structures and solutions for
        industrial and infrastructure projects.
      </p>
    </div>
  </div>
</footer>
