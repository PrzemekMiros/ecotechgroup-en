---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { serviceSchema } from "../lib/structured-data";
interface Props {
  item: CollectionEntry<"production">;
}
const { item } = Astro.props;
const content: Record<
  string,
  { title: string; intro: string; details: string[] }
> = {
  "pale-rurowe": {
    title: "Steel pipe piles",
    intro: "Steel pipe piles for foundation and civil-engineering projects.",
    details: [
      "We supply and fabricate pipe piles to match the required diameter, wall thickness, steel grade and installation method.",
      "Contact us with your project documentation for a tailored quotation.",
    ],
  },
  "kolnierze-rurowe": {
    title: "Pipe flanges",
    intro:
      "Steel pipe flanges manufactured for secure, durable pipeline connections.",
    details: [
      "We select dimensions, material and execution to suit the operating conditions and applicable standard.",
      "Send your drawing or specification for a technical and commercial proposal.",
    ],
  },
  "paloscianki-rurowe-combiwall": {
    title: "Combiwall pipe sheet piles",
    intro:
      "Combined pipe-sheet-pile wall systems for retaining and waterfront structures.",
    details: [
      "The system is configured for the required loads, ground conditions and construction method.",
      "We support material supply and fabrication for the project scope.",
    ],
  },
  "produkcja-i-walcowanie-blach": {
    title: "Plate fabrication and rolling",
    intro:
      "Steel plate rolling and fabrication for pipes, shells and structural components.",
    details: [
      "We process material to the required geometry and technical documentation.",
      "Provide dimensions, material grade and quantity for a tailored offer.",
    ],
  },
  "produkcja-kolan-segmentowych": {
    title: "Segment bends",
    intro: "Segment bends fabricated for steel pipeline systems.",
    details: [
      "The bend geometry, material and wall thickness are selected for the pipeline design.",
      "We manufacture to the supplied drawing or agreed technical specification.",
    ],
  },
  "produkcja-kominow-stalowych-przemyslowych": {
    title: "Industrial steel chimneys",
    intro:
      "Fabrication of steel chimneys and exhaust-system components for industrial applications.",
    details: [
      "We match the design to operating conditions, dimensions and installation requirements.",
      "Contact us to discuss your project and receive a quotation.",
    ],
  },
  "produkcja-ploz-dystansowych": {
    title: "Spacer skids",
    intro: "Spacer skids for safe positioning of pipelines inside casings.",
    details: [
      "The design is selected for the pipe dimensions, casing and installation method.",
      "We prepare the required quantity and configuration for your project.",
    ],
  },
  "produkcja-podpor-mostowych": {
    title: "Bridge bearings",
    intro:
      "Steel bridge-support components manufactured for infrastructure projects.",
    details: [
      "Fabrication is based on project documentation and structural requirements.",
      "We agree the material, dimensions and quality-control scope before production.",
    ],
  },
  "produkcja-zbiornikow-stalowych": {
    title: "Steel tanks",
    intro: "Steel tanks and process vessels for industrial applications.",
    details: [
      "We fabricate tanks to the required capacity, material grade and operating conditions.",
      "Send your specification to receive a technical and commercial offer.",
    ],
  },
  "rozpory-rurowe-systemowe": {
    title: "System pipe struts",
    intro: "System pipe struts for temporary support and excavation works.",
    details: [
      "We select the components for the expected loads and project geometry.",
      "Contact our team to discuss the required configuration.",
    ],
  },
};
const page = content[item.data.slug] || {
  title: item.data.title,
  intro: "Steel fabrication for industrial and infrastructure projects.",
  details: [
    "We prepare the scope according to your technical requirements.",
    "Contact us for availability, schedule and pricing.",
  ],
};
---

<BaseLayout
  breadcrumbs={[{ name: "Manufacturing", path: "/produkcja/" }]}
  title={`${page.title} | Eco Tech Group`}
  description={page.intro}
  image={item.data.image}
  imageAlt={page.title}
  structuredData={[serviceSchema(page.title, page.intro, Astro.url.pathname)]}
>
  <article class="production-page">
    <PageHero
      title={page.title}
      breadcrumbs={[{ label: "Manufacturing", href: "/produkcja/" }]}
      image={item.data.image}
      imageAlt={page.title}
    />
    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 lg:py-24">
      <div class="max-w-4xl text-base leading-7 text-ink/75">
        <p class="text-xl leading-8 text-ink md:text-2xl">{page.intro}</p>
        {page.details.map((detail) => (
          <p class="mt-6">{detail}</p>
        ))}
        <a
          href="/kontakt/"
          class="mt-10 inline-flex bg-accent-1 px-7 py-4 text-sm font-semibold text-white hover:bg-accent-1/85"
        >
          Request a quotation
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
