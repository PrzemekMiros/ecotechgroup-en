---
const languages = { en: "English", de: "German", da: "Danish" };
const sections = [
  {
    id: "gas-industry",
    title: "Gas industry",
    description: "",
    people: [
      {
        name: "Michał Pilarczyk",
        role: "Sales specialist",
        email: "michal@ecotechgroup.pl",
        phone: "+48 506 902 126",
        image: "Michal-Pilarczyk.png",
        languages: ["en"],
      },
    ],
  },
  {
    id: "international-markets",
    title: "International markets",
    description:
      "Contact our export-sales team for support with international orders.",
    people: [
      {
        name: "Krzysztof Śluzek",
        role: "International sales (western and eastern markets)",
        email: "krzysztof@ecotechgroup.pl",
        phone: "+48 504 347 960",
        image: "Krzysztof-Sluzek.png",
        languages: ["en", "de"],
      },
      {
        name: "Hanna Kalusok",
        role: "International sales (western markets)",
        email: "hanna.kalusok@ecotechgroup.pl",
        phone: "+48 503 082 320",
        image: "Hanna_Kalusok.png",
        languages: ["en", "de", "da"],
      },
      {
        name: "Marta Olk",
        role: "Export Manager (western and eastern markets)",
        email: "marta.olk@ecotechgroup.pl",
        phone: "+48 882 378 136",
        image: "Marta_Olk.png",
        languages: ["en"],
      },
    ],
  },
];
---

<div class="mt-16 space-y-16 md:mt-20 md:space-y-20">
  {sections.map((section) => (
    <section aria-labelledby={section.id}>
      <h2 id={section.id} class="text-xl font-semibold text-ink md:text-2xl">
        {section.title}
      </h2>
      {section.description && (
        <p class="mt-5 max-w-4xl text-base leading-7 text-ink/75">
          {section.description}
        </p>
      )}
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {section.people.map((person) => (
          <article class="rounded border border-ink/15 bg-white px-5 py-10 text-center lg:px-6 lg:py-12">
            <img
              src={`/img/contact/${person.image}`}
              alt={person.name}
              width="128"
              height="128"
              class="mx-auto size-28 rounded-full border-2 border-accent-1 object-cover"
              loading="lazy"
            />
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <h3 class="text-lg font-semibold text-ink">{person.name}</h3>
              <span class="inline-flex items-center gap-2">
                {person.languages.map((language) => (
                  <img
                    src={`/img/contact/${language}.png`}
                    alt={languages[language as keyof typeof languages]}
                    title={languages[language as keyof typeof languages]}
                    width="26"
                    height="18"
                    class="h-[18px] w-[26px] object-cover"
                    loading="lazy"
                  />
                ))}
              </span>
            </div>
            <p class="mt-5 text-base font-semibold leading-6 text-accent-1">
              {person.role}
            </p>
            <a
              href={`mailto:${person.email}`}
              class="mt-4 block break-words text-base leading-7 text-ink/70 hover:text-accent-1"
            >
              {person.email}
            </a>
            <a
              href={`tel:${person.phone.replace(/\s/g, "")}`}
              class="mt-4 block text-base leading-7 text-ink/70 hover:text-accent-1"
            >
              {person.phone}
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}
  <div class="space-y-5 text-xl font-semibold text-ink md:text-2xl">
    <a href="tel:+48508299077" class="block hover:text-accent-1">
      +48 508 299 077
    </a>
    <a
      href="mailto:sprzedaz@ecotechgroup.pl"
      class="block break-words hover:text-accent-1"
    >
      sales@ecotechgroup.pl
    </a>
  </div>
</div>
