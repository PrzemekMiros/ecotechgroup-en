---
import { serializeSchema } from "../lib/structured-data";
const faq = [
  {
    question: "How are steel pipes manufactured?",
    answer:
      "Welded pipes are made by forming plate or strip and welding its edges. Seamless pipes are produced from solid steel stock. The specification may also require heat treatment and anti-corrosion protection.",
  },
  {
    question: "What can steel pipes carry?",
    answer:
      "Steel pipes can carry water, steam, oil, gas and other industrial media. The pipe must be selected for the medium, pressure, temperature, material and required surface protection.",
  },
  {
    question: "What are steel pipes used for?",
    answer:
      "They are used in building and bridge structures, water and drainage systems, industrial pipelines, energy, heating, chemical and petrochemical projects.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<div class="pipe-overview mt-16 border-t border-ink/10 pt-12 text-base leading-7 text-ink/75">
  <section>
    <h2>Steel pipes and anti-corrosion protection</h2>
    <p>
      We supply welded and seamless steel pipes in a wide range of diameters,
      from 88.9 to 3,600 mm. Wall thickness depends on the pipe type and
      manufacturing process. We match the material to structural, pressure and
      pipeline requirements and confirm availability for each enquiry.
    </p>
    <p>
      We also provide anti-corrosion protection, including 3LPE external
      insulation, internal and external epoxy coatings, and galvanising.
    </p>
  </section>
  <section>
    <h2>Applications</h2>
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <h3>Construction</h3>
        <p>
          Steel pipes are used in building frames, bridge structures, water,
          drainage and industrial installations, as well as railings, barriers
          and architectural elements.
        </p>
      </div>
      <div>
        <h3>Industrial infrastructure</h3>
        <p>
          In industry, pipes transport raw materials, liquids and gases,
          including steam, hot water, oil and natural gas. They are also used in
          chimneys, fire-protection installations and drainage systems.
        </p>
      </div>
    </div>
  </section>
  <section>
    <h2>Available dimensions</h2>
    <p>
      When selecting a pipe, specify its outside diameter, wall thickness,
      length, steel grade, manufacturing standard and weld type. Our team will
      prepare an offer based on the required quantity, delivery location,
      cutting, coating and documentation requirements.
    </p>
    <p>
      Use our{" "}
      <a href="/kalkulator-wagi-rur-stalowych/">steel pipe weight calculator</a>{" "}
      to estimate material weight.
    </p>
  </section>
  <section>
    <h2>Frequently asked questions</h2>
    <div class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
      {faq.map((item) => (
        <details class="py-5">
          <summary class="cursor-pointer font-semibold text-ink">
            {item.question}
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</div>
<script type="application/ld+json" set:html={serializeSchema(faqSchema)} />
<style>
  .pipe-overview section + section {
    margin-top: 3rem;
  }
  .pipe-overview h2 {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .pipe-overview h3 {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
  }
  .pipe-overview p {
    margin-top: 1rem;
  }
  .pipe-overview a {
    color: var(--color-accent-1);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
