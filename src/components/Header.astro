---
import { getCollection } from "astro:content";
import { productionUrl } from "../lib/production-url";
import darkLogo from "../assets/img/logo/EcoTech_Logo_dark.png";
import NavigationLink from "./NavigationLink.astro";

const links = [
  {
    href: "/rury-stalowe/",
    label: "Steel pipes",
    dropdown: true,
    menu: "pipes",
  },
  { href: "/uslugi/", label: "Services", dropdown: true, menu: "services" },
  {
    href: "/produkcja/",
    label: "Manufacturing",
    dropdown: true,
    menu: "production",
  },
  { href: "/aktualnosci/", label: "News", dropdown: false },
  { href: "/do-pobrania/", label: "Downloads", dropdown: false },
  { href: "/praca/", label: "Careers", dropdown: false },
  { href: "/o-nas/", label: "About us", dropdown: false },
  { href: "/kontakt/", label: "Contact", dropdown: false },
] as const;
const pathname = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const productionItems = (await getCollection("production")).sort(
  (a, b) => a.data.order - b.data.order,
);
const pipeCategories = (await getCollection("steelPipeCategories")).sort(
  (a, b) => a.data.order - b.data.order,
);
const itemHref = (
  menu: "pipes" | "services" | "production",
  baseHref: string,
  slug: string,
) =>
  menu === "pipes"
    ? `/rury-stalowe-${slug}/`
    : menu === "production"
      ? productionUrl(slug)
      : `${baseHref.replace(/\/$/, "")}/${slug}/`;
const items = (menu: "pipes" | "services" | "production") =>
  menu === "pipes"
    ? pipeCategories
    : menu === "production"
      ? productionItems
      : services;
const allLabel = (menu: "pipes" | "services" | "production") =>
  menu === "pipes"
    ? "All categories"
    : menu === "production"
      ? "All manufacturing"
      : "All services";
---

<header class="absolute inset-x-0 top-0 z-30 text-white">
  <div class="mx-auto grid min-h-20 max-w-7xl grid-cols-[1fr_auto] items-center gap-8 px-5 lg:px-8">
    <a href="/" class="w-fit" aria-label="Eco Tech Group home page">
      <img
        src="/img/logo/EcoTech_Logo_white.png"
        width="350"
        height="53"
        alt="Eco Tech Group"
        class="site-logo--light h-6 w-auto xs:h-8 sm:h-8 lg:h-8 md:-mb-12"
      />
      <img
        src={darkLogo.src}
        width="211"
        height="32"
        alt="Eco Tech Group"
        class="site-logo--dark h-6 w-auto xs:h-8 sm:h-8 lg:h-8 md:-mb-12"
      />
    </a>
    <div class="hidden self-stretch lg:block">
      <div class="flex h-[66px] items-center justify-end gap-7 text-sm font-medium">
        <div
          class="flex items-center gap-4 text-lg"
          aria-label="Language selector"
        >
          <a
            href="https://ecotech-group.uk/"
            aria-label="English"
            class="transition-opacity hover:opacity-70"
          >
            🇵🇱
          </a>
          <a
            href="https://ecotechgroup.de/"
            aria-label="Deutsch"
            class="transition-opacity hover:opacity-70"
          >
            🇩🇪
          </a>
        </div>
        <a
          href="mailto:sprzedaz@ecotechgroup.pl"
          class="text-white/90 transition-colors hover:text-white"
        >
          sales@ecotechgroup.pl
        </a>
        <a
          href="/kontakt/"
          class="bg-accent-1 px-9 py-3 text-sm font-semibold tracking-[0.02em] transition-colors hover:bg-accent-1/85"
        >
          Send an enquiry
        </a>
      </div>
      <nav
        class="flex h-[44px] items-center justify-end gap-8 border-t border-white/20 text-sm font-semibold"
        aria-label="Main navigation"
      >
        {links.map((link) =>
          link.dropdown ? (
            <div class="group relative flex h-full items-center">
              <a
                href={link.href}
                aria-haspopup="true"
                class:list={[
                  "flex h-full items-center gap-2 transition-colors hover:text-white/70 group-focus-within:text-white",
                  pathname.startsWith(link.href.replace(/\/$/, ""))
                    ? "text-white"
                    : "text-white/90",
                ]}
              >
                {link.label}
                <span aria-hidden="true">⌄</span>
              </a>
              <div class="pointer-events-none fixed inset-x-0 top-[113px] z-50 translate-y-2 pt-3 opacity-0 transition duration-200 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="mx-auto max-w-7xl px-5 lg:px-8">
                  <div class="border border-ink/10 bg-white p-8 shadow-2xl shadow-ink/15">
                    <div class="flex items-end justify-between gap-8 border-b border-ink/10 pb-6">
                      <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-1">
                        {link.label}
                      </p>
                      <a
                        href={link.href}
                        class="shrink-0 text-sm font-semibold text-accent-1 transition-colors hover:text-ink"
                      >
                        {allLabel(link.menu)} →
                      </a>
                    </div>
                    <div class="mt-6 grid grid-cols-2 gap-x-10 gap-y-1">
                      {items(link.menu).map((item, index) => (
                        <a
                          href={itemHref(link.menu, link.href, item.data.slug)}
                          class="flex items-start gap-3 border-b border-ink/8 py-4 text-ink/70 transition-colors hover:border-accent-1 hover:text-accent-1"
                        >
                          <span class="pt-0.5 text-xs font-bold tracking-[0.12em] text-accent-1/65">
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <span class="leading-5">{item.data.title}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <NavigationLink
              href={link.href}
              class={[
                "flex items-center gap-2 transition-colors hover:text-white/70",
                pathname === link.href ? "text-white" : "text-white/90",
              ].join(" ")}
            >
              {link.label}
            </NavigationLink>
          ),
        )}
      </nav>
    </div>
    <details class="group justify-self-end lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-3 bg-accent-1 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-1/85 [&::-webkit-details-marker]:hidden">
        <span>Menu</span>
        <span aria-hidden="true">☰</span>
      </summary>
      <div class="fixed inset-x-0 top-20 z-40 max-h-[calc(100svh-5rem)] overflow-y-auto border-t border-ink/10 bg-white text-ink shadow-2xl shadow-ink/15">
        <nav class="mx-auto max-w-7xl px-5 py-6" aria-label="Mobile navigation">
          <div class="divide-y divide-ink/10 border-y border-ink/10">
            {links.map((link) =>
              link.dropdown ? (
                <details class="group/mobile">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                    {link.label}
                    <span class="text-accent-1" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="pb-5">
                    <a
                      href={link.href}
                      class="mb-2 block text-sm font-semibold text-sun"
                    >
                      {allLabel(link.menu)} →
                    </a>
                    <div class="grid gap-1 sm:grid-cols-2">
                      {items(link.menu).map((item) => (
                        <a
                          href={itemHref(link.menu, link.href, item.data.slug)}
                          class="block py-2 text-sm text-ink/65 hover:text-accent-1"
                        >
                          {item.data.title}
                        </a>
                      ))}
                    </div>
                  </div>
                </details>
              ) : (
                <NavigationLink
                  href={link.href}
                  class="flex items-center justify-between py-5 text-lg font-semibold hover:text-accent-1"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-accent-1/60">
                    →
                  </span>
                </NavigationLink>
              ),
            )}
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <a
              href="/kontakt/"
              class="bg-accent-1 px-5 py-4 text-center text-sm font-semibold text-white hover:bg-accent-1/85"
            >
              Send an enquiry
            </a>
            <a
              href="mailto:sprzedaz@ecotechgroup.pl"
              class="border border-ink/20 px-5 py-4 text-center text-sm font-semibold text-ink hover:border-accent-1 hover:text-accent-1"
            >
              sales@ecotechgroup.pl
            </a>
          </div>
        </nav>
      </div>
    </details>
  </div>
</header>

<style is:global>
  .site-logo--dark {
    display: none;
  }
  body:has(.product-page) > header .site-logo--light,
  body:has(.pipe-category-page) > header .site-logo--light {
    display: none;
  }
  body:has(.product-page) > header .site-logo--dark,
  body:has(.pipe-category-page) > header .site-logo--dark {
    display: block;
  }
</style>
