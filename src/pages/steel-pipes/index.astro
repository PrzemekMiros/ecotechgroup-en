---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SteelPipesOverview from "../../components/SteelPipesOverview.astro";
import SteelPipeFilters from "../../components/SteelPipeFilters.astro";
import {
  readPipeFilters,
  matchesPipeFilters,
} from "../../lib/pipe-filters.mjs";
import { itemListSchema } from "../../lib/structured-data";
const categories = (await getCollection("steelPipeCategories")).sort(
  (a, b) => a.data.order - b.data.order,
);
export const prerender = false;
const filters = readPipeFilters(Astro.url.searchParams);
const hasFilters = Object.values(filters).some(Boolean);
const results = hasFilters
  ? (await getCollection("steelPipeProducts"))
      .filter((product) => matchesPipeFilters(product, filters))
      .sort((a, b) => a.data.order - b.data.order)
  : [];
if (hasFilters && results.length === 0) Astro.response.status = 404;
const names: Record<string, string> = {
  "bez-szwu": "Seamless",
  dwudzielne: "Split",
  uzywane: "Used",
  "w-izolacji": "Insulated",
  "ze-szwem-spiralnym": "Spiral welded",
  "ze-szwem-wzdluznym": "Longitudinally welded",
  "zwijane-z-blachy": "Plate rolled",
};
---

<BaseLayout
  title="Steel pipes | Eco Tech Group"
  description="Steel-pipe catalogue: welded, seamless, insulated, split and used pipes."
  structuredData={[
    hasFilters
      ? itemListSchema(
          "Steel pipe filtering results",
          results.map(({ data }) => ({
            name: data.title,
            path: `/${data.slug}/`,
          })),
        )
      : itemListSchema(
          "Steel pipe categories",
          categories.map(({ data }) => ({
            name: names[data.slug] || data.title,
            path: `/rury-stalowe-${data.slug}/`,
          })),
        ),
  ]}
>
  <PageHero title="Steel pipes" />
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
      <div class="min-w-0">
        {hasFilters && (
          <section
            id="results"
            aria-labelledby="search-results-title"
            class="mb-12 scroll-mt-8"
          >
            <h2
              id="search-results-title"
              class="text-2xl font-semibold text-accent-1"
            >
              {filters.q ? `Search results: ${filters.q}` : "Filtering results"}
            </h2>
            <p class="mt-3" role="status">
              Products found: {results.length}.
            </p>
            {results.length ? (
              <ul class="mt-5 divide-y divide-ink/10 border-y border-ink/10">
                {results.map(({ data }) => (
                  <li>
                    <a
                      class="block px-4 py-4 font-semibold text-accent-1 hover:bg-mist"
                      href={`/${data.slug}/`}
                    >
                      {data.title}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3">
                No pipes match the selected criteria. Change the parameters,
                clear the filters or{" "}
                <a href="/kontakt/" class="text-accent-1 underline">
                  ask us to select a pipe
                </a>
                .
              </p>
            )}
          </section>
        )}
        <div class="mb-10 max-w-5xl space-y-4 text-base leading-7 text-ink/75">
          <p>
            Our range includes steel pipes for structural, pressure and gas
            applications. We match the product to your project requirements,
            applicable standard and operating conditions.
          </p>
          <p>
            We work with reliable suppliers and offer longitudinally and
            spiral-welded, seamless, insulated, split, plate-rolled and used
            steel pipes. Select a category to view the available products.
          </p>
        </div>
        <nav
          class="flex max-w-3xl flex-wrap gap-2.5"
          aria-label="Steel pipe categories"
        >
          {categories.map((category) => (
            <a
              href={`/rury-stalowe-${category.data.slug}/`}
              class="inline-flex items-center rounded-md border border-accent-1 bg-white px-3 py-2 text-base leading-6 text-accent-1 hover:bg-accent-1 hover:text-white"
            >
              {names[category.data.slug] || category.data.title}
            </a>
          ))}
        </nav>
        <SteelPipesOverview />
      </div>
      <SteelPipeFilters selected={filters} class="order-first lg:order-none" />
    </div>
  </section>
</BaseLayout>
