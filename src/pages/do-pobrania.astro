---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
const catalogs = [
  {
    title: "Eco Tech Group Catalogue 2026",
    language: "Polish edition",
    lang: "pl",
    href: "/pdf/EcoTech_katalog_PL_2026.pdf",
    size: "4.55 MB",
  },
  {
    title: "Eco Tech Group Catalogue 2026",
    language: "English edition",
    lang: "en",
    href: "/pdf/EcoTech_katalog_2026_EN.pdf",
    size: "3.83 MB",
  },
];
---

<BaseLayout
  title="Downloads | Eco Tech Group"
  description="Eco Tech Group documents, catalogues and technical materials."
>
  <PageHero title="Downloads" />
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Materials</p>
      <h2 class="mt-3 text-xl font-semibold md:text-2xl">
        Downloadable PDF catalogues
      </h2>
      <p class="mt-5 text-ink/70">
        Explore the Eco Tech Group range. Open or download the catalogue in your
        preferred language.
      </p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {catalogs.map((catalog) => (
        <article class="flex flex-col border border-accent-1/15 bg-white p-6">
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent-1">
            PDF · {catalog.size}
          </p>
          <h3 lang={catalog.lang} class="mt-8 text-2xl font-semibold">
            {catalog.title}
          </h3>
          <p class="mt-3 text-sm text-ink/65">{catalog.language}</p>
          <div class="mt-auto flex flex-wrap gap-5 pt-7">
            <a
              href={catalog.href}
              download
              class="bg-accent-1 px-5 py-3 text-sm font-semibold text-white hover:bg-ink"
            >
              Download PDF ↓
            </a>
            <a
              href={catalog.href}
              target="_blank"
              rel="noopener noreferrer"
              hreflang={catalog.lang}
              class="text-sm font-semibold text-accent-1 underline"
            >
              Open catalogue ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
