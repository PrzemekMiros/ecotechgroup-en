---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SteelPipeCarousel from "../components/SteelPipeCarousel.astro";
import DeliveryMap from "../components/DeliveryMap.astro";
import ContactFormHandler from "../components/ContactFormHandler.astro";
import heroImage from "../assets/img/main/hero-industrial-pipes.jpg";
import workshopImage from "../assets/img/main/eco-tech-o-firmie.jpg";
import hallImage from "../assets/img/main/hala-rury-stalowe-wynajem.jpg";
import logosImage from "../assets/img/main/logos-desktop.webp";
---

<BaseLayout
  title="Steel pipe supplier"
  description="Eco Tech Group supplies steel pipes, steel structures and pipe-processing services for industrial and infrastructure projects."
>
  <section class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-[#020307] text-white">
    <Picture
      src={heroImage}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      formats={["avif", "webp"]}
      alt="Industrial warehouse with steel pipes"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div class="mx-auto w-full max-w-7xl px-5 py-24 md:px-8 md:py-32">
      <div class="max-w-4xl">
        <p class="text-lg text-white/85 md:text-2xl">
          More than 15 years of experience
        </p>
        <h1 class="mt-8 max-w-5xl text-5xl font-semibold leading-[0.98] tracking-[-0.055em] text-white">
          Steel pipe distributor
        </h1>
        <p class="mt-8 max-w-2xl text-white/75">
          Eco Tech Group is an importer, distributor and leading stockholder of
          steel pipes in Poland. We also provide steel-pipe processing,
          protection and steel fabrication services.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            class="px-7 py-4 text-sm font-semibold text-white hover:bg-white/10 md:px-9 md:py-5 md:text-base"
            href="/rury-stalowe/"
          >
            Steel pipe range
          </a>
          <a
            class="bg-accent-1 px-7 py-4 text-sm font-semibold text-white hover:bg-accent-1/85 md:px-9 md:py-5 md:text-base"
            href="/kontakt/"
          >
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-[#020307] text-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 pb-20 md:grid-cols-2 md:items-start md:px-8 md:pb-28">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold md:text-3xl">The EcoTech range</h2>
        <div class="mt-8 space-y-7 text-base leading-7 text-white/75">
          <p>
            Our experience and industry knowledge help us understand the market
            and respond to its requirements. We work with dozens of
            steel-product manufacturers in Poland and abroad to provide
            high-quality products at competitive prices.
          </p>
          <p>
            Our customer-service model is built around reliable technical advice
            and efficient handling of large orders. We supply products
            individually matched to each customer's requirements.
          </p>
        </div>
      </div>
      <div class="relative z-10 md:-mb-44">
        <Picture
          src={workshopImage}
          widths={[640, 960, 1440]}
          sizes="(min-width: 768px) 50vw, 100vw"
          formats={["avif", "webp"]}
          alt="Eco Tech Group technician operating machinery"
          loading="lazy"
          class="h-full min-h-[28rem] w-full object-cover md:min-h-[40rem]"
        />
      </div>
    </div>
  </section>
  <SteelPipeCarousel />
  <section class="relative isolate overflow-hidden bg-[#020b1c] py-20 text-white md:py-28">
    <Picture
      src={hallImage}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      formats={["avif", "webp"]}
      alt="Steel pipes in an Eco Tech Group warehouse"
      loading="lazy"
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-35"
    />
    <div class="absolute inset-0 -z-10 bg-[#01091c]/90"></div>
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <h2 class="text-2xl font-semibold md:text-3xl">Why work with us?</h2>
      <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-14">
        <div>
          <h3 class="text-xl font-semibold">Exceptional quality</h3>
          <p class="mt-6 text-white/70">
            We source from leading steel-pipe manufacturers and provide the
            quality certificates required for each order.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-semibold">More than sales</h3>
          <p class="mt-6 text-white/70">
            Alongside supply, we fabricate steel structures and provide pipe
            protection, dismantling, purchasing and cutting services.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-semibold">Dedicated adviser</h3>
          <p class="mt-6 text-white/70">
            Every customer receives support from a dedicated adviser who matches
            the offer to the project and suggests practical alternatives.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-[#f3f4f5] py-20 text-[#0f1c2a] md:py-28">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <h2 class="text-2xl font-semibold md:text-3xl">How we fulfil orders</h2>
      <p class="mt-8 max-w-2xl">
        Our order process is designed to provide clear communication and fast
        delivery.
      </p>
      <div class="mt-16 grid gap-12 lg:grid-cols-3 lg:gap-14">
        <div>
          <span class="text-6xl font-semibold text-[#113d6e]">01</span>
          <p class="mt-8 text-lg text-[#27384c]">
            We receive your enquiry and pass the order to our delivery team.
          </p>
        </div>
        <div>
          <span class="text-6xl font-semibold text-[#113d6e]">02</span>
          <p class="mt-8 text-lg text-[#27384c]">
            Standard sizes can often be supplied quickly from our continuously
            available stock of at least 8,000 tonnes of steel pipes.
          </p>
        </div>
        <div>
          <span class="text-6xl font-semibold text-[#113d6e]">03</span>
          <p class="mt-8 text-lg text-[#27384c]">
            For sourced products, our logistics network and EU warehouse
            partners help us keep lead times as short as possible.
          </p>
        </div>
      </div>
      <div class="mt-16 flex justify-center">
        <a
          class="bg-[#0f2d5a] px-10 py-4 font-semibold text-white hover:bg-[#163d74]"
          href="/kontakt/"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
  <DeliveryMap />
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <h2 class="mb-8 text-center text-3xl font-semibold text-ink md:text-4xl">
        Trusted by
      </h2>
      <Picture
        src={logosImage}
        widths={[640, 960, 1440]}
        sizes="100vw"
        formats={["avif", "webp"]}
        alt="Selected Eco Tech Group clients"
        loading="lazy"
        class="w-full"
      />
    </div>
  </section>
  <section id="contact" class="bg-[#0e0f24] py-16 text-white md:py-24">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
        <form
          class="contact-form bg-white/[0.045] p-6 sm:p-9 md:p-10"
          novalidate
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="sm:col-span-2">
              <span class="sr-only">Full name</span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Full name"
                class="w-full border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              />
            </label>
            <label>
              <span class="sr-only">Phone number</span>
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                placeholder="Phone number"
                class="w-full border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              />
            </label>
            <label>
              <span class="sr-only">Email address</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Email address"
                class="w-full border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              />
            </label>
            <label>
              <span class="sr-only">Company name</span>
              <input
                type="text"
                name="company"
                autocomplete="organization"
                placeholder="Company name"
                class="w-full border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              />
            </label>
            <label>
              <span class="sr-only">VAT ID</span>
              <input
                type="text"
                name="nip"
                placeholder="VAT ID"
                class="w-full border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              />
            </label>
            <label class="sm:col-span-2">
              <span class="sr-only">Message</span>
              <textarea
                name="message"
                rows="5"
                placeholder="Message"
                class="w-full resize-y border border-white/85 bg-transparent px-5 py-4 text-sm text-white outline-none placeholder:text-white/55 focus:border-sun focus:ring-1 focus:ring-sun"
              ></textarea>
            </label>
          </div>
          <label class="mt-5 flex items-start gap-3 text-sm leading-5 text-white/60">
            <input
              type="checkbox"
              name="privacy"
              class="mt-0.5 size-4 shrink-0 accent-accent-1"
            />
            <span>
              I consent to the processing of my personal data in order to
              receive a response to my enquiry.
            </span>
          </label>
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />
          <p
            class="contact-form-status mt-4 text-sm text-white/80"
            aria-live="polite"
          ></p>
          <button
            type="submit"
            class="mt-8 w-full bg-accent-1 px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-accent-1/85 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send form
          </button>
        </form>
        <div class="pt-1 lg:pt-16">
          <p class="max-w-xl text-lg font-semibold md:text-xl">
            We are available Monday to Friday, 8:00–16:00. We will be happy to
            advise and answer your questions.
          </p>
          <div class="mt-14 border-l-4 border-accent-1 pl-8">
            <p class="text-white/60">Address</p>
            <address class="mt-4 not-italic">
              Mieczysława Pożaryskiego 32
              <br />
              04-703 Warsaw, Poland
            </address>
            <p class="mt-9 text-white/60">Email</p>
            <a href="mailto:sprzedaz@ecotechgroup.pl" class="mt-4 inline-block">
              sales@ecotechgroup.pl
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 md:grid-cols-[.8fr_1.2fr] md:px-8">
      <div>
        <p class="eyebrow">Help and information</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink md:text-4xl">
          Frequently asked questions
        </h2>
        <p class="mt-5 text-lg text-ink/70">
          Answers about availability, orders, delivery and payment.
        </p>
        <a
          href="/kontakt/"
          class="mt-8 inline-flex bg-accent-1 px-6 py-3.5 text-sm font-semibold text-white"
        >
          Contact us
        </a>
      </div>
      <div class="border-t-2 border-accent-1">
        <details open class="border-b border-accent-1/15 py-6">
          <summary class="cursor-pointer text-lg font-semibold">
            How can I check product availability?
          </summary>
          <p class="mt-4 leading-7 text-ink/70">
            Contact our sales team with the required pipe type, dimensions, wall
            thickness, weld type and quantity. We will confirm availability and
            prepare a quotation.
          </p>
        </details>
        <details class="border-b border-accent-1/15 py-6">
          <summary class="cursor-pointer text-lg font-semibold">
            How do I order steel pipes?
          </summary>
          <p class="mt-4 leading-7 text-ink/70">
            Contact one of our sales specialists to receive a detailed
            commercial offer, then place the order directly with the adviser.
          </p>
        </details>
        <details class="border-b border-accent-1/15 py-6">
          <summary class="cursor-pointer text-lg font-semibold">
            What is the delivery time?
          </summary>
          <p class="mt-4 leading-7 text-ink/70">
            Lead time depends on the order size and availability. For stock
            goods, it is normally up to five working days; larger deliveries are
            agreed individually.
          </p>
        </details>
        <details class="border-b border-accent-1/15 py-6">
          <summary class="cursor-pointer text-lg font-semibold">
            How does delivery work?
          </summary>
          <p class="mt-4 leading-7 text-ink/70">
            You can collect your order from our warehouse in Kobierne, or we can
            arrange transport throughout Poland and the EU.
          </p>
        </details>
        <details class="border-b border-accent-1/15 py-6">
          <summary class="cursor-pointer text-lg font-semibold">
            What payment options are available?
          </summary>
          <p class="mt-4 leading-7 text-ink/70">
            Payment terms are agreed individually. New customers are generally
            asked for prepayment; established customers may be eligible for
            agreed credit terms.
          </p>
        </details>
      </div>
    </div>
  </section>
  <ContactFormHandler />
</BaseLayout>
