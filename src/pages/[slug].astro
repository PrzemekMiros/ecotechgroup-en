---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactFormHandler from "../components/ContactFormHandler.astro";
import { absoluteUrl, pageUrl } from "../lib/structured-data";
import { getImageDimensions } from "../lib/image-dimensions.mjs";
import {
  englishCategoryName,
  englishProductName,
  englishParameterLabel,
} from "../lib/english";
import { englishSlug, urls } from "../lib/urls";
export const prerender = true;
export async function getStaticPaths() {
  const products = await getCollection("steelPipeProducts");
  return products.map((product) => ({
    params: { slug: englishSlug(product.data.slug) },
    props: { product },
  }));
}
interface Props {
  product: CollectionEntry<"steelPipeProducts">;
}
const { product } = Astro.props;
const categoryName = englishCategoryName(product.data.category);
const name = englishProductName(
  product.data.category,
  product.data.specification,
);
const productImage =
  product.data.category === "dwudzielne"
    ? "/img/pipes/rury-stalowe-dwudzielne.jpg"
    : "/img/pipes/rura-stalowa.jpg";
const dimensions = getImageDimensions(productImage);
const parameters = [
  { label: "Specification", value: product.data.specification },
  { label: "Steel grade", value: product.data.steelGrade },
  { label: "Production method", value: product.data.productionMethod },
  { label: "Intended use", value: product.data.intendedUse },
  ...product.data.technicalParameters.map((item) => ({
    label: englishParameterLabel(item.label),
    value: item.value,
  })),
].filter((item): item is { label: string; value: string } =>
  Boolean(item.value),
);
const description = `${name}. Availability, quality requirements and delivery terms are confirmed for the selected specification in response to your enquiry.`;
const schema = {
  "@type": "Product",
  url: pageUrl(Astro.url.pathname),
  mainEntityOfPage: { "@id": `${pageUrl(Astro.url.pathname)}#webpage` },
  image: absoluteUrl(productImage),
  name,
  description,
  sku: product.data.sku,
  category: categoryName,
  additionalProperty: parameters.map((parameter) => ({
    "@type": "PropertyValue",
    name: parameter.label,
    value: parameter.value,
  })),
};
---

<BaseLayout
  title={`${name} | Eco Tech Group`}
  description={description}
  image={productImage}
  imageAlt={name}
  structuredData={[schema]}
  breadcrumbs={[
    { name: "Steel pipes", path: urls.steelPipes },
    { name: categoryName, path: urls.category(product.data.category) },
  ]}
>
  <article class="product-page bg-white pt-32 text-ink lg:pt-38">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <nav
        class="flex flex-wrap items-center gap-x-2 gap-y-1 py-6 text-sm text-ink/55"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-accent-1">
          Home
        </a>
        <span>/</span>
        <a href={urls.steelPipes} class="hover:text-accent-1">
          Steel pipes
        </a>
        <span>/</span>
        <a
          href={urls.category(product.data.category)}
          class="hover:text-accent-1"
        >
          {categoryName}
        </a>
        <span>/</span>
        <span aria-current="page">{name}</span>
      </nav>
    </div>
    <div class="product-shell mx-auto max-w-7xl">
      <section class="product-main px-5 pb-16 pt-4 md:px-8 lg:px-10 lg:pb-24">
        <div class="mx-auto max-w-4xl">
          <div class="grid gap-8 md:grid-cols-[15rem_minmax(0,1fr)]">
            <figure class="aspect-square w-full overflow-hidden border border-ink/10 bg-sand">
              <img
                src={productImage}
                width={dimensions.width}
                height={dimensions.height}
                loading="eager"
                alt={name}
                class="h-full w-full object-contain"
              />
            </figure>
            <div>
              <p class="eyebrow">{categoryName}</p>
              <h1 class="mt-3 text-2xl font-semibold leading-tight tracking-[-0.04em] text-ink md:text-3xl">
                {name}
              </h1>
              <p class="mt-6 text-base leading-7 text-ink/65">{description}</p>
              <a
                href="#enquiry"
                class="mt-5 inline-flex text-sm font-semibold text-accent-1 hover:text-ink"
              >
                Check availability and request a quotation →
              </a>
              {product.data.sku && (
                <p class="mt-5 text-sm text-ink/65">SKU: {product.data.sku}</p>
              )}
            </div>
          </div>
          <section class="mt-12" aria-labelledby="details-heading">
            <h2 id="details-heading" class="mb-6 text-xl font-semibold">
              Technical details and documentation
            </h2>
            <div data-product-tabs>
              <div
                class="overflow-x-auto border-b border-ink/15"
                role="tablist"
                aria-label="Product information"
              >
                <button
                  class="product-tab is-active"
                  id="parameters-tab"
                  type="button"
                  role="tab"
                  aria-selected="true"
                  aria-controls="parameters-panel"
                >
                  Technical parameters
                </button>
                <button
                  class="product-tab"
                  id="description-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="description-panel"
                  tabindex="-1"
                >
                  Description
                </button>
                <button
                  class="product-tab"
                  id="quality-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="quality-panel"
                  tabindex="-1"
                >
                  Warranty / certificates
                </button>
                <button
                  class="product-tab"
                  id="documents-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="documents-panel"
                  tabindex="-1"
                >
                  Downloads
                </button>
                <button
                  class="product-tab"
                  id="reviews-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="reviews-panel"
                  tabindex="-1"
                >
                  Reviews
                </button>
              </div>
              <div
                class="pt-8"
                id="parameters-panel"
                role="tabpanel"
                aria-labelledby="parameters-tab"
              >
                <dl class="border border-ink/10">
                  {parameters.map((parameter, index) => (
                    <div
                      class:list={[
                        "grid md:grid-cols-[11.5rem_minmax(0,1fr)]",
                        index > 0 && "border-t border-ink/10",
                        index % 2 === 1 && "bg-sand",
                      ]}
                    >
                      <dt class="border-b border-ink/10 px-5 py-4 text-sm font-semibold md:border-b-0 md:border-r">
                        {parameter.label}
                      </dt>
                      <dd class="px-5 py-4 text-sm leading-6 text-ink/75">
                        {parameter.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
              <div
                class="pt-8"
                id="description-panel"
                role="tabpanel"
                aria-labelledby="description-tab"
                hidden
              >
                <div class="max-w-3xl leading-7 text-ink/75">
                  <p>{description}</p>
                  <p class="mt-4">
                    The final pipe selection should take account of the required
                    dimensions, steel grade, standard, operating conditions and
                    project documentation. Our team confirms the product
                    configuration before an order is placed.
                  </p>
                </div>
              </div>
              <div
                class="pt-8"
                id="quality-panel"
                role="tabpanel"
                aria-labelledby="quality-tab"
                hidden
              >
                <div class="max-w-3xl border border-accent-1/15 bg-mist p-6">
                  <h3 class="text-lg font-semibold">
                    Warranty and quality certificates
                  </h3>
                  <p class="mt-3 text-sm leading-6 text-ink/70">
                    Quality parameters, certificates and inspection documents
                    are confirmed for the specific material batch and order
                    requirements.
                  </p>
                  <p class="mt-3 text-sm leading-6 text-ink/70">
                    Before purchase, we confirm the applicable standard, steel
                    grade and required documentation for your project.
                  </p>
                </div>
              </div>
              <div
                class="pt-8"
                id="documents-panel"
                role="tabpanel"
                aria-labelledby="documents-tab"
                hidden
              >
                {product.data.documents.length ? (
                  <ul class="max-w-3xl divide-y divide-ink/10 border-y border-ink/10">
                    {product.data.documents.map((document) => (
                      <li>
                        <a
                          class="flex items-center justify-between gap-4 px-1 py-4 font-semibold text-accent-1 hover:text-ink"
                          href={document.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span>{document.title}</span>
                          <span class="shrink-0 text-xs font-bold uppercase tracking-[0.12em]">
                            {document.type} PDF →
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <div class="max-w-3xl border border-dashed border-ink/20 bg-white p-6">
                    <h3 class="font-semibold">
                      Documents for a specific material batch
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-ink/70">
                      Request a declaration, material certificate or technical
                      data sheet for the selected specification.
                    </p>
                    <a
                      class="mt-4 inline-flex text-sm font-semibold text-accent-1 hover:text-ink"
                      href="#enquiry"
                    >
                      Request documentation →
                    </a>
                  </div>
                )}
              </div>
              <div
                class="pt-8"
                id="reviews-panel"
                role="tabpanel"
                aria-labelledby="reviews-tab"
                hidden
              >
                <div class="max-w-3xl border border-dashed border-ink/20 bg-white p-6">
                  <h3 class="font-semibold">Product reviews</h3>
                  <p class="mt-2 text-sm leading-6 text-ink/70">
                    No reviews have been published for this product yet.
                  </p>
                </div>
              </div>
            </div>
          </section>
        </div>
      </section>
      <aside
        id="enquiry"
        class="bg-[#f1f4f6] px-5 py-9 md:px-8 lg:px-10 lg:py-12"
      >
        <form class="contact-form mx-auto max-w-md" novalidate>
          <p class="text-2xl font-semibold text-ink">Request availability</p>
          <p class="mt-3 text-sm leading-6 text-ink/65">
            Send the details needed to prepare an offer. We will respond with
            availability and a quotation.
          </p>
          <div class="mt-7 grid gap-3">
            <input
              type="text"
              name="product"
              value={name}
              readonly
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink/75"
            />
            <input
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Full name"
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink"
            />
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              placeholder="Phone number"
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink"
            />
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="Email address"
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink"
            />
            <input
              type="text"
              name="company"
              autocomplete="organization"
              placeholder="Company name"
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink"
            />
            <textarea
              name="message"
              rows="5"
              placeholder="Your message"
              class="w-full border border-ink/15 bg-white px-4 py-4 text-sm text-ink"
            ></textarea>
          </div>
          <label class="mt-5 flex gap-3 text-sm leading-5 text-ink/55">
            <input
              type="checkbox"
              name="privacy"
              class="mt-0.5 size-5 accent-accent-1"
            />
            <span>
              I consent to processing of my personal data in order to respond to
              my enquiry.
            </span>
          </label>
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
          />
          <p
            class="contact-form-status mt-4 text-sm text-ink/70"
            aria-live="polite"
          ></p>
          <button
            type="submit"
            class="mt-6 w-full bg-accent-1 px-8 py-4 text-sm font-semibold text-white hover:bg-accent-1/85"
          >
            Send enquiry
          </button>
        </form>
      </aside>
    </div>
  </article>
  <ContactFormHandler />
</BaseLayout>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-product-tabs]")
    .forEach((group) => {
      const tabs = Array.from(
        group.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );
      const panels = tabs
        .map((tab) =>
          document.getElementById(tab.getAttribute("aria-controls") || ""),
        )
        .filter((panel): panel is HTMLElement => Boolean(panel));
      const activate = (active: HTMLButtonElement) => {
        tabs.forEach((tab) => {
          const selected = tab === active;
          tab.classList.toggle("is-active", selected);
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden = panel.id !== active.getAttribute("aria-controls");
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key))
            return;
          event.preventDefault();
          const next =
            event.key === "Home"
              ? 0
              : event.key === "End"
                ? tabs.length - 1
                : (index +
                    (event.key === "ArrowRight" ? 1 : -1) +
                    tabs.length) %
                  tabs.length;
          tabs[next].focus();
          activate(tabs[next]);
        });
      });
    });
</script>
<style>
  .product-tab {
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(20 43 58 / 65%);
  }
  .product-tab:hover,
  .product-tab.is-active {
    border-color: var(--color-accent-1);
    color: var(--color-accent-1);
  }
  @media (min-width: 1024px) {
    .product-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 25rem;
    }
  }
  @media (min-width: 1280px) {
    .product-shell {
      grid-template-columns: minmax(0, 1fr) 28rem;
    }
  }
</style>
