---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferCard from "../components/OfferCard.astro";
import PageHero from "../components/PageHero.astro";
const offers = [
  [
    "01",
    "Water management",
    "Solutions for wastewater treatment, retention and water reuse.",
  ],
  [
    "02",
    "Pipe systems",
    "Components for industrial, water and wastewater installations.",
  ],
  [
    "03",
    "Separation and filtration",
    "Equipment for efficient contaminant separation and installation protection.",
  ],
  [
    "04",
    "Tanks and retention",
    "Storage and controlled rainwater-management systems.",
  ],
  [
    "05",
    "Specialist products",
    "Solutions selected for the requirements of a specific project.",
  ],
  [
    "06",
    "Project support",
    "Technical consultation, quotations and support during project delivery.",
  ],
];
---

<BaseLayout title="Offer | Eco Tech Group">
  <PageHero title="Offer" />
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {offers.map(([number, title, description]) => (
        <OfferCard number={number} title={title} description={description} />
      ))}
    </div>
  </section>
</BaseLayout>
