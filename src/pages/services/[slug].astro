---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { serviceSchema } from "../../lib/structured-data";
export const prerender = true;
export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}
interface Props {
  service: CollectionEntry<"services">;
}
const { service } = Astro.props;
const content: Record<
  string,
  { title: string; intro: string; details: string[] }
> = {
  "spawanie-i-produkcja-rurociagow-stalowych": {
    title: "Steel pipeline welding and fabrication",
    intro:
      "We fabricate and weld steel pipelines for industrial and infrastructure projects.",
    details: [
      "Our team matches the welding method, material and scope of work to the technical documentation and operating conditions.",
      "We can support the project from material preparation through fabrication to delivery of completed components.",
    ],
  },
  "skup-rur-stalowych": {
    title: "Steel pipe purchase",
    intro:
      "We purchase used steel pipes and offer an efficient, transparent assessment process.",
    details: [
      "Send the pipe dimensions, condition, quantity and collection location for an individual offer.",
      "We arrange logistics and agree the collection terms for the selected material.",
    ],
  },
  "montaz-rur-stalowych-dwudzielnych": {
    title: "Split steel pipe installation",
    intro:
      "We install split steel pipes for the protection and renovation of existing pipelines.",
    details: [
      "The installation process is tailored to the pipe diameter, site conditions and project requirements.",
      "Contact us with the technical data to discuss the suitable solution.",
    ],
  },
  "malowanie-rur-od-wewnatrz": {
    title: "Internal pipe coating",
    intro:
      "We apply internal protective coatings that help improve corrosion resistance and service life.",
    details: [
      "The coating system is selected according to the conveyed medium and operating environment.",
      "We confirm the required surface preparation and quality requirements before work begins.",
    ],
  },
  "laminowanie-rur-stalowych": {
    title: "Steel pipe lamination",
    intro:
      "We provide laminated protective layers for steel pipes used in demanding operating conditions.",
    details: [
      "The scope and system are selected individually for the application and expected exposure.",
      "Ask us for a quotation based on dimensions, quantity and technical requirements.",
    ],
  },
  "izolowanie-rur-stalowych": {
    title: "Steel pipe insulation",
    intro:
      "We provide insulation and anti-corrosion protection for steel pipes.",
    details: [
      "Available systems include solutions selected for underground, industrial and infrastructure applications.",
      "We agree the coating type, thickness, preparation standard and documentation for each order.",
    ],
  },
};
const page = content[service.data.slug] || {
  title: service.data.title,
  intro:
    "Professional steel-pipe services for industrial and infrastructure projects.",
  details: [
    "We prepare the scope of work individually according to your technical requirements.",
    "Contact us to discuss availability, schedule and pricing.",
  ],
};
---

<BaseLayout
  title={`${page.title} | Eco Tech Group`}
  description={page.intro}
  image={service.data.image}
  imageAlt={page.title}
  structuredData={[serviceSchema(page.title, page.intro, Astro.url.pathname)]}
>
  <article class="service-page">
    <PageHero
      title={page.title}
      breadcrumbs={[{ label: "Services", href: "/uslugi/" }]}
      image={service.data.image}
      imageAlt={page.title}
    />
    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 lg:py-24">
      <div class="max-w-4xl text-base leading-7 text-ink/75">
        <p class="text-xl leading-8 text-ink md:text-2xl">{page.intro}</p>
        {page.details.map((detail) => (
          <p class="mt-6">{detail}</p>
        ))}
        <a
          href="/kontakt/"
          class="mt-10 inline-flex bg-accent-1 px-7 py-4 text-sm font-semibold text-white hover:bg-accent-1/85"
        >
          Request a quotation
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
