---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactFormHandler from "../components/ContactFormHandler.astro";
import PageHero from "../components/PageHero.astro";
import RegionalContacts from "../components/RegionalContacts.astro";
import SpecialistContacts from "../components/SpecialistContacts.astro";
const mapQuery =
  "Eco Tech Group Sp. z o.o., Mieczysława Pożaryskiego 32, 04-703 Warszawa, Poland";
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;
---

<BaseLayout
  title="Contact | Eco Tech Group"
  description="Contact Eco Tech Group for steel-pipe supply, technical support and delivery in Poland and the EU."
>
  <PageHero title="Contact" />
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3 text-lg tracking-[-0.04em] md:text-xl">
        We provide commercial and technical support for steel-pipe deliveries
        for infrastructure, industrial and construction projects.
      </h2>
      <p class="mt-5 text-lg leading-8 text-ink/70">
        We are available Monday to Friday, 8:00–16:00.
      </p>
    </div>
    <section
      class="mt-10 border border-ink/10 bg-white text-center md:mt-12"
      aria-labelledby="minimum-logistics"
    >
      <h2
        id="minimum-logistics"
        class="px-5 py-6 text-xl font-semibold tracking-[-0.035em] text-ink md:py-7 md:text-2xl"
      >
        Minimum order quantities
      </h2>
      <div class="grid border-t border-ink/10 md:grid-cols-3">
        <div class="border-b border-ink/10 px-6 py-7 md:border-b-0 md:border-r md:px-8 md:py-8">
          <h3 class="text-lg font-semibold text-ink">
            Diameter 114 mm and above
          </h3>
          <p class="mt-2 text-base leading-6 text-ink/65">
            Full mill lengths, e.g.
          </p>
          <p class="mt-5 text-2xl font-bold text-accent-1 md:text-3xl">
            6 or 12 m
          </p>
        </div>
        <div class="border-b border-ink/10 px-6 py-7 md:border-b-0 md:border-r md:px-8 md:py-8">
          <h3 class="text-lg font-semibold text-ink">Diameter below 114 mm</h3>
          <p class="mt-2 text-base leading-6 text-ink/65">Minimum order</p>
          <p class="mt-5 text-2xl font-bold text-accent-1 md:text-3xl">
            1.5 tonnes
          </p>
        </div>
        <div class="px-6 py-7 md:px-8 md:py-8">
          <h3 class="text-lg font-semibold text-ink">Cutting to length</h3>
          <p class="mx-auto mt-2 max-w-xs text-base leading-6 text-ink/65">
            Available to customer requirements; purchase is always in full mill
            lengths.
          </p>
        </div>
      </div>
      <p class="border-t border-ink/10 px-6 py-6 text-base leading-6 text-ink/65">
        We will prepare the details and quotation individually — please contact
        us.
      </p>
    </section>
    <div class="mt-12 grid overflow-hidden border border-accent-1/15 bg-white lg:grid-cols-2">
      <form
        id="contact-form"
        class="contact-form scroll-mt-8 p-6 sm:p-8 lg:p-10"
        novalidate
      >
        <div class="flex items-center justify-between gap-5 border-b border-ink/10 pb-6">
          <p class="text-sm leading-6 text-ink/60">
            Complete the form and we will get back to you.
          </p>
        </div>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="sr-only">Full name</span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Full name"
              class="w-full border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            />
          </label>
          <label>
            <span class="sr-only">Phone number</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              placeholder="Phone number"
              class="w-full border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            />
          </label>
          <label>
            <span class="sr-only">Email address</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="Email address"
              class="w-full border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            />
          </label>
          <label>
            <span class="sr-only">Company name</span>
            <input
              type="text"
              name="company"
              autocomplete="organization"
              placeholder="Company name"
              class="w-full border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            />
          </label>
          <label>
            <span class="sr-only">VAT ID</span>
            <input
              type="text"
              name="nip"
              placeholder="VAT ID"
              class="w-full border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            />
          </label>
          <label class="sm:col-span-2">
            <span class="sr-only">Message</span>
            <textarea
              name="message"
              rows="5"
              placeholder="Message"
              class="w-full resize-y border border-ink/15 bg-sand px-4 py-3.5 text-sm text-ink"
            ></textarea>
          </label>
        </div>
        <label class="mt-5 flex items-start gap-3 text-sm leading-5 text-ink/55">
          <input
            type="checkbox"
            name="privacy"
            class="mt-0.5 size-4 accent-accent-1"
          />
          <span>
            I consent to the processing of my personal data in order to respond
            to my enquiry.
          </span>
        </label>
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <p
          class="contact-form-status mt-4 text-sm text-ink/70"
          aria-live="polite"
        ></p>
        <button
          type="submit"
          class="mt-6 bg-accent-1 px-7 py-4 text-sm font-semibold text-white hover:bg-accent-1/85"
        >
          Send form
        </button>
      </form>
      <div class="relative min-h-[32rem] overflow-hidden bg-mist lg:min-h-full">
        <iframe
          src={mapUrl}
          title="Directions to Eco Tech Group"
          class="absolute inset-0 h-full w-full border-0 grayscale-[0.75] contrast-[0.85]"
          loading="lazy"
        ></iframe>
        <div class="pointer-events-none absolute inset-x-5 top-5 bg-white/95 p-5 shadow-xl sm:left-6 sm:right-auto sm:top-6 sm:max-w-xs">
          <p class="text-lg font-semibold text-ink">
            Eco Tech Group Sp. z o.o.
          </p>
          <address class="mt-2 text-sm leading-6 not-italic text-ink/65">
            Mieczysława Pożaryskiego 32
            <br />
            04-703 Warsaw, Poland
          </address>
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pointer-events-auto mt-4 inline-flex text-sm font-semibold text-accent-1 hover:text-ink"
          >
            Get directions →
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8 md:pb-24">
    <RegionalContacts />
    <SpecialistContacts />
  </section>
  <ContactFormHandler />
</BaseLayout>
