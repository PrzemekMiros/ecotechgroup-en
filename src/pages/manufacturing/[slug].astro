---
import { getCollection } from "astro:content";
import ProductionPage from "../../components/ProductionPage.astro";
import { englishSlug } from "../../lib/urls";

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection("production");
  return items.map((item) => ({
    params: { slug: englishSlug(item.data.slug) },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<ProductionPage item={item} />
